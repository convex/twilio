{
  "name": "@convex-dev/twilio",
  "description": "Convex component for sending/receiving SMS messages with Twilio.",
  "version": "0.2.3",
  "type": "module",
  "repository": "github:convex/twilio",
  "homepage": "https://github.com/convex/twilio#readme",
  "bugs": {
    "email": "support@convex.dev",
    "url": "https://github.com/convex/twilio/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "twilio",
    "component"
  ],
  "scripts": {
    "dev": "convex dev --start 'npm run dev:build'",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "predev": "convex init && npm run build:codegen",
    "prepack": "npm run build",
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example/convex",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run --typecheck",
    "check": "npm run test && npm run typecheck && npm run lint",
    "test:e2e": "convex init && npm run build:codegen && convex dev --once --typecheck-components",
    "format": "prettier --write .",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "dependencies": {
    "convex-helpers": "^0.1.128"
  },
  "peerDependencies": {
    "convex": "^1.24.8"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@convex-dev/eslint-plugin": "2.0.0",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "chokidar-cli": "3.0.0",
    "convex": "1.49.0",
    "convex-test": "0.0.69",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "pkg-pr-new": "0.0.93",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.10"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js"
}
